{
  "version": 1,
  "author": "Richard Rodriguez - UTP / Desarrollo de Software VIII",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 110,
      "left": 260,
      "attrs": {}
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 30,
      "left": -30,
      "attrs": { "lux": "400" }
    },
    {
      "type": "wokwi-led",
      "id": "led_alarm",
      "top": 145,
      "left": 20,
      "attrs": { "color": "red", "label": "ALARM" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 180,
      "left": 100,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_status",
      "top": 225,
      "left": 20,
      "attrs": { "color": "green", "label": "ARMED" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 260,
      "left": 100,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn",
      "top": 315,
      "left": 20,
      "attrs": { "color": "blue", "label": "ARMAR/DESARMAR", "key": "b" }
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": 370,
      "left": 170,
      "attrs": { "delayTime": "5" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 80,
      "left": 460,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 250,
      "left": 480,
      "attrs": { "mode": "smooth", "volume": "1.0" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "ldr:AO", "esp:34", "yellow", [ "h70", "v90" ] ],
    [ "ldr:VCC", "esp:3V3", "red", [ "h50", "v85" ] ],
    [ "ldr:GND", "esp:GND.1", "black", [ "h35", "v205" ] ],

    [ "led_alarm:A", "r1:1", "red", [ "v0" ] ],
    [ "r1:2", "esp:25", "red", [ "h30", "v18" ] ],
    [ "led_alarm:C", "esp:GND.1", "black", [ "v8", "h170", "v62" ] ],

    [ "led_status:A", "r2:1", "green", [ "v0" ] ],
    [ "r2:2", "esp:27", "green", [ "h30", "v-42" ] ],
    [ "led_status:C", "esp:GND.1", "black", [ "v8", "h170", "v-18" ] ],

    [ "btn:1.l", "esp:14", "blue", [ "h-10", "v-90", "h215" ] ],
    [ "btn:2.l", "esp:GND.1", "black", [ "h-18", "v-95", "h223" ] ],

    [ "pir:OUT", "esp:13", "orange", [ "v-15", "h20", "v-70" ] ],
    [ "pir:GND", "esp:GND.1", "black", [ "v-25", "h-5", "v-70" ] ],
    [ "pir:VCC", "esp:3V3", "red", [ "v-20", "h-35", "v-215" ] ],

    [ "oled:GND", "esp:GND.2", "black", [ "v-15", "h-95", "v80" ] ],
    [ "oled:SCL", "esp:22", "magenta", [ "v-25", "h-115", "v108" ] ],
    [ "oled:SDA", "esp:21", "cyan", [ "v-35", "h-105", "v146" ] ],
    [ "oled:VCC", "esp:3V3", "red", [ "v-45", "h-265", "v105" ] ],

    [ "buzzer:1", "esp:GND.3", "black", [ "v15", "h-105", "v-140" ] ],
    [ "buzzer:2", "esp:26", "purple", [ "v35", "h-295", "v-145" ] ]
  ],
  "dependencies": {}
}
