{
  "version": 1,
  "author": "Richard Rodriguez - UTP / Desarrollo de Software VIII",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 150,
      "left": 260,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": 40,
      "left": 0,
      "attrs": { "delayTime": "5" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 230,
      "left": 0,
      "attrs": { "lux": "400" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 400,
      "left": 120,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_alarm",
      "top": 380,
      "left": 20,
      "attrs": { "color": "red", "label": "ALARM" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 470,
      "left": 120,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_status",
      "top": 450,
      "left": 20,
      "attrs": { "color": "green", "label": "ARMED" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn",
      "top": 530,
      "left": 20,
      "attrs": { "color": "blue", "label": "ARMAR/DESARMAR", "key": "b" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 60,
      "left": 660,
      "attrs": { "mode": "smooth", "volume": "1.0" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 240,
      "left": 660,
      "attrs": { "i2cAddress": "0x3c" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "pir:OUT", "esp:13", "orange", [] ],

    [ "ldr:AO", "esp:34", "yellow", [] ],

    [ "led_alarm:A", "r1:1", "red", [] ],
    [ "r1:2", "esp:25", "red", [] ],

    [ "led_status:A", "r2:1", "green", [] ],
    [ "r2:2", "esp:27", "green", [] ],

    [ "btn:1.l", "esp:14", "blue", [] ],

    [ "buzzer:2", "esp:26", "purple", [] ],

    [ "oled:SDA", "esp:21", "cyan", [] ],
    [ "oled:SCL", "esp:22", "magenta", [] ],

    [ "esp:3V3", "pir:VCC", "red", [] ],
    [ "esp:3V3", "ldr:VCC", "red", [] ],
    [ "esp:3V3", "oled:VCC", "red", [] ],

    [ "esp:GND.1", "pir:GND", "black", [] ],
    [ "esp:GND.1", "ldr:GND", "black", [] ],
    [ "esp:GND.1", "led_alarm:C", "black", [] ],
    [ "esp:GND.1", "led_status:C", "black", [] ],
    [ "esp:GND.1", "buzzer:1", "black", [] ],

    [ "esp:GND.2", "oled:GND", "black", [] ],
    [ "esp:GND.2", "btn:2.l", "black", [] ]
  ],
  "dependencies": {}
}
